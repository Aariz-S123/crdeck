.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
# Raw API data stays out of git (spec 9.7); fetch dates live in each file's metadata.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/
data/notebooks_out/
data/*.log
